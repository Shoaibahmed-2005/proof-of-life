# ── Application ─────────────────────────────────────────────────────────
PROJECT_NAME="Proof of Life Backend"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]
# Also allow the portal opened from another device on the LAN (http://192.168.x.x:5173)
CORS_ALLOW_LAN=true
# At startup, check the backend answers on its own Wi-Fi address (warns if not)
LAN_SELF_CHECK=true

# ── Security ────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="secret-key-change-me-in-production"
# Fernet key for face templates at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a development key is created in data/template.key.
TEMPLATE_KEY=""
# P-256 PEM private key that signs life-certificate credentials (issuer DID).
# If empty, a development key is created in data/issuer_key.pem.
ISSUER_KEY_PEM=""
# Demo officer, created on first start if there are no officers
DEMO_OFFICER_USERNAME="officer"
DEMO_OFFICER_PASSWORD="officer123"

# ── Storage ─────────────────────────────────────────────────────────────
# Default: sqlite database in backend/data/iob.db
# DATABASE_URL="sqlite:///./data/iob.db"

# ── Sessions / QR ───────────────────────────────────────────────────────
SESSION_EXPIRY_SECONDS=300
# URL the phone uses to reach this backend (goes into the QR code).
# Empty = auto: the Wi-Fi/Ethernet adapter's IP (the startup banner shows the
# choice and warns if VPN/WSL/VirtualBox adapters exist). Set it to pin one:
#   http://192.168.1.20:8000            (same Wi-Fi)
#   https://<name>.trycloudflare.com    (cloudflared tunnel)
PUBLIC_BASE_URL=""
TIMESTAMP_MAX_SKEW_SECONDS=120
CHALLENGE_TIMEOUT_SECONDS=8

# ── Liveness ────────────────────────────────────────────────────────────
BPM_MIN=40
BPM_MAX=220
# The app's stability gate. These are sent to the phone in the QR code, so
# changing them needs only a backend restart, not an app rebuild.
# Change them ONLY from measured data: `python scripts/calibrate_thresholds.py scans`
# (TESTING_CHECKLIST.md, "Scan speed comparison"). Lowering MIN_SNR_DB also
# makes photos easier to pass.
MIN_SNR_DB=3.0
RPPG_WINDOW_SEC=10
RPPG_STABLE_COUNT=5
RPPG_STABLE_TOLERANCE_BPM=3.0
RPPG_SCAN_TIMEOUT_SEC=30

# ── Face match: PLACEHOLDERS, calibrate with scripts/calibrate_thresholds.py ──
FACE_T_HIGH=0.70
FACE_T_LOW=0.50
FACE_ANCHOR_MIN=0.55
TEMPLATE_BLEND_ALPHA=0.10
FACE_MODEL_VERSION="mobilefacenet-192-v1"

# ── Pension status rules ────────────────────────────────────────────────
MAX_FAILED_ATTEMPTS=3
CERTIFICATE_DEADLINE="11-30"
SCORE_LOG_ENABLED=true
